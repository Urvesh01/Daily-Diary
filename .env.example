# Copy to .env for local development (never commit .env).
# On Vercel add the same names under Project -> Settings -> Environment Variables.

# MongoDB Atlas connection string (include the database name, e.g. /diary)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/diary?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
